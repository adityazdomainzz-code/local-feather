[Unit]
Description=LocalNode Agent (FeatherPanel KVM/libvirt VDS host)
After=network-online.target libvirtd.service
Wants=network-online.target
Requires=libvirtd.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/localnode
Environment=LOCALNODE_CONFIG=/etc/localnode/config.yaml
ExecStart=/opt/localnode/venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8443
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Hardening
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

[Install]
WantedBy=multi-user.target
